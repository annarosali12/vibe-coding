          </a>
        </article>

        <!-- Card 3: Photo Gallery Slider -->
        <article class="bg-white rounded-3xl p-6 shadow-md hover:shadow-xl border border-slate-100 transition-all duration-300 flex flex-col justify-between group hover:-translate-y-1 relative overflow-hidden">
          <div class="absolute top-0 right-0 w-24 h-24 bg-sky-100/50 rounded-bl-full -z-0 pointer-events-none group-hover:scale-110 transition-transform"></div>
          <div>
            <div class="w-14 h-14 bg-sky-100 text-sky-600 rounded-2xl flex items-center justify-center text-2xl mb-5 shadow-inner">
              <i class="fa-solid fa-images" aria-hidden="true"></i>
            </div>
            <div class="flex items-center gap-2 mb-2">
              <span class="text-xs font-bold uppercase tracking-wider text-sky-600 bg-sky-50 px-2.5 py-1 rounded-md">Gallery</span>
              <span class="text-xs text-slate-400">Photo Slider</span>
            </div>
            <h3 class="text-xl font-bold text-slate-800 font-heading mb-2 group-hover:text-sky-600 transition-colors">
              Photo Gallery Slider
            </h3>
            <p class="text-slate-600 text-sm leading-relaxed mb-6">
              An interactive image slider showcasing adorable moments, funny poses, and heartwarming pet memories.
            </p>
          </div>
          <a href="https://annarosali12.github.io/vibe-coding/pictures/" 
             target="_blank" 
             rel="noopener noreferrer" 
             class="w-full bg-slate-50 hover:bg-sky-500 hover:text-white text-slate-700 font-semibold py-3 px-4 rounded-xl transition-all duration-200 flex items-center justify-center gap-2 group-hover:shadow-md"
             aria-label="Open Photo Gallery Slider in a new tab">
            <span>View Photos</span>
            <i class="fa-solid fa-arrow-up-right-from-square text-xs" aria-hidden="true"></i>
          </a>
        </article>

        <!-- Card 4: Macaroni and Cheese Recipe Card -->
        <article class="bg-white rounded-3xl p-6 shadow-md hover:shadow-xl border border-slate-100 transition-all duration-300 flex flex-col justify-between group hover:-translate-y-1 relative overflow-hidden">
          <div class="absolute top-0 right-0 w-24 h-24 bg-orange-100/50 rounded-bl-full -z-0 pointer-events-none group-hover:scale-110 transition-transform"></div>
          <div>
