            <p class="text-slate-600 text-sm leading-relaxed mb-6">
              A handy Pomodoro-style timer to help keep productivity flowing between cozy pet snuggle breaks.
            </p>
          </div>
          <a href="https://annarosali12.github.io/vibe-coding/pomodoro" 
             target="_blank" 
             rel="noopener noreferrer" 
             class="w-full bg-slate-50 hover:bg-emerald-500 hover:text-white text-slate-700 font-semibold py-3 px-4 rounded-xl transition-all duration-200 flex items-center justify-center gap-2 group-hover:shadow-md"
             aria-label="Open Work Timer in a new tab">
