    </main>

    <!-- Footer Section -->
    <footer class="w-full max-w-5xl mx-auto px-4 py-8 text-center text-slate-500 text-sm border-t border-slate-200/60 mt-10">
      <p class="flex items-center justify-center gap-1.5 font-medium">
        <span>Made with</span>
        <i class="fa-solid fa-heart text-rose-500 animate-pulse" aria-label="love"></i>
        <span>and treats by Anna</span>
      </p>
      <p class="mt-1 text-xs text-slate-400">
        © <span id="currentYear"></span> Anna's Vibe Coding Apps. All rights reserved.
      </p>
    </footer>

  </div>

  <script>
    // v1.1 - Added Mac & Cheese Recipe Card and Work Timer links
    // Plain language JavaScript implementation for interactivity & cheer features

    document.addEventListener('DOMContentLoaded', () => {
      
      // Dynamic footer year setting
      // Updates the year automatically so the copyright stays current
      const yearSpan = document.getElementById('currentYear');
      if (yearSpan) {
        yearSpan.textContent = new Date().getFullYear();
      }

      // --- CHEER CONFETTI FUNCTIONALITY ---
      // Triggers festive multi-colored confetti whenever the user clicks the Instant Cheer button
      const cheerBtn = document.getElementById('cheerBtn');
      cheerBtn.addEventListener('click', () => {
        // Fire canvas-confetti celebration explosion
        if (typeof confetti === 'function') {
          confetti({
            particleCount: 80,
            spread: 70,
            origin: { y: 0.6 },
            colors: ['#f43f5e', '#f59e0b', '#38bdf8', '#a855f7']
          });
        }
        showToast("Hope your day gets even brighter! ✨🐶🐱");
      });

      // --- SYNTHESIZED CLICKER SOUND (Web Audio API) ---
      // Creates a real clicker sound effect using the browser's audio context
      // No external audio file needed! Runs 100% locally in browser.
      const clickerBtn = document.getElementById('clickerBtn');
      clickerBtn.addEventListener('click', () => {
        playClickerSound();
        showToast("Click! Good dog! 🦴");
      });

      function playClickerSound() {
        try {
          const AudioContext = window.AudioContext || window.webkitAudioContext;
          if (!AudioContext) return;
          const ctx = new AudioContext();

          // Quick dual impulse frequency simulating a metallic training clicker
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();

          osc.type = 'square';
          osc.frequency.setValueAtTime(1200, ctx.currentTime);
          osc.frequency.exponentialRampToValueAtTime(400, ctx.currentTime + 0.03);

          gain.gain.setValueAtTime(0.3, ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.03);

          osc.connect(gain);
          gain.connect(ctx.destination);

          osc.start();
          osc.stop(ctx.currentTime + 0.03);
        } catch (e) {
          // Fallback if browser audio context is blocked
          console.log("Audio not allowed yet:", e);
        }
      }

      // --- FUNNY PET QUOTES / FACTS GENERATOR ---
      // A rotating list of cheerful, relatable quotes about Anna's dog and kitten
      const petQuotes = [
        "\"A glass of water left unattended is legally kitten property!\" 🐱💧",
        "\"Clicker training tip: 1 click = 1 treat = 1 extremely happy dog!\" 🐶🦴",
        "\"4.5 pounds of fluff can somehow occupy 100% of a king-sized bed.\" 🛋️",
        "\"Nosy dogs make the best assistant coders.\" 💻🐾",
        "\"Food on a plate is just a kitten snack waiting to be swiped!\" 🐟",
        "\"Happiness is a tail wag and a purring kitten.\" ❤️"
      ];

      const petFactQuote = document.getElementById('petFactQuote');
      const newFactBtn = document.getElementById('newFactBtn');
      let currentQuoteIndex = 0;

      newFactBtn.addEventListener('click', () => {
        currentQuoteIndex = (currentQuoteIndex + 1) % petQuotes.length;
        // Fade effect transition
        petFactQuote.style.opacity = '0';
        setTimeout(() => {
          petFactQuote.textContent = petQuotes[currentQuoteIndex];
          petFactQuote.style.opacity = '1';
        }, 150);
      });

      // Smooth opacity transition styling for quote
      petFactQuote.style.transition = 'opacity 0.2s ease-in-out';

      // --- TOAST NOTIFICATION HELPER ---
      // Displays a polite notification at the bottom right when interactions occur
      let toastTimeout;
      function showToast(message) {
        const toast = document.getElementById('toastMessage');
        const toastText = document.getElementById('toastText');
        
        toastText.textContent = message;
        toast.classList.remove('hidden');
        toast.classList.add('flex');

        clearTimeout(toastTimeout);
        toastTimeout = setTimeout(() => {
          toast.classList.add('hidden');
          toast.classList.remove('flex');
        }, 3000);
      }
    });
  </script>
</body>
</html>
