        <div class="max-w-xl mx-auto">
          <div class="inline-block p-3 bg-white rounded-full text-rose-500 shadow-sm mb-3">
            <i class="fa-solid fa-quote-left text-xl" aria-hidden="true"></i>
          </div>
          <h3 class="text-xl font-bold text-slate-800 font-heading mb-2">Pet Mom Secret of the Day</h3>
          <p id="petFactQuote" class="text-slate-700 text-base sm:text-lg italic min-h-[3.5rem] flex items-center justify-center">
            "A glass left unattended is legally kitten property!" 🐾
          </p>
          <button id="newFactBtn" class="mt-4 bg-white hover:bg-rose-50 text-slate-800 font-medium px-4 py-2 rounded-xl border border-slate-200 text-sm transition-all duration-200 hover:shadow-sm flex items-center gap-2 mx-auto">
            <i class="fa-solid fa-rotate text-rose-500" aria-hidden="true"></i>
            <span>Get Another Funny Quote</span>
          </button>
        </div>
