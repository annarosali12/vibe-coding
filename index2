<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Anna's Pet Paradise & Web Corner 🐾</title>

  <!--
    Version: v1.1 - Added Mac & Cheese Recipe and Work Timer cards
    Author: Anna
    Description: Personal homepage linking to pet-themed and productivity web apps with cheer-up interactive elements.
  -->

  <!-- Tailwind CSS CDN for modern responsive utility styling -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- FontAwesome CDN for cute icons (paws, cats, dogs, hearts, camera) -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <!-- Canvas Confetti CDN for the instant cheer button -->
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

  <!-- Custom Google Fonts: Quicksand for playful headers, Inter for readable body text -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

  <style>
    /* Custom font bindings */
    body {
      font-family: 'Inter', sans-serif;
      background-color: #FDFBF7;
      color: #332C27;
    }
    h1, h2, h3, .font-heading {
      font-family: 'Quicksand', sans-serif;
    }

    /* Soft floating animation for cute background icons and badges */
    @keyframes floatSlow {
      0%, 100% { transform: translateY(0px) rotate(0deg); }
      50% { transform: translateY(-8px) rotate(3deg); }
    }
    .animate-float {
      animation: floatSlow 4s ease-in-out infinite;
    }

    /* Custom keyboard focus ring style for enhanced accessibility */
    a:focus-visible, button:focus-visible {
      outline: 3px solid #E07A5F !important;
      outline-offset: 4px !important;
      border-radius: 0.5rem;
    }

    /* Wiggle hover animation for interactive buttons */
    @keyframes wiggle {
      0%, 100% { transform: rotate(0deg); }
      25% { transform: rotate(-5deg); }
      75% { transform: rotate(5deg); }
    }
    .hover-wiggle:hover {
      animation: wiggle 0.3s ease-in-out infinite;
    }
  </style>
</head>

<body class="min-h-screen flex flex-col justify-between selection:bg-rose-200 selection:text-rose-900">

  <!-- Main Container -->
  <div class="relative overflow-hidden min-h-screen flex flex-col justify-between">

    <!-- Decorative Top Background Blob -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-96 bg-gradient-to-b from-amber-100/60 via-rose-100/40 to-transparent -z-10 rounded-b-full blur-2xl pointer-events-none" aria-hidden="true"></div>

    <!-- Header / Hero Section -->
    <header class="w-full max-w-5xl mx-auto px-4 pt-10 pb-6 text-center">
      <!-- Pet Badge Pill -->
      <div class="inline-flex items-center gap-2 bg-amber-100 text-amber-900 px-4 py-1.5 rounded-full text-sm font-medium mb-6 shadow-sm border border-amber-200/60 animate-float">
        <i class="fa-solid fa-paw text-amber-600" aria-hidden="true"></i>
        <span>Welcome to Anna's Happy Pet Corner</span>
        <i class="fa-solid fa-heart text-rose-500" aria-hidden="true"></i>
      </div>

      <!-- Main Title -->
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold font-heading text-slate-800 tracking-tight leading-tight">
        Hi, I'm <span class="text-rose-600 underline decoration-amber-300 decoration-wavy decoration-2">Anna</span>! 🐾
      </h1>

      <!-- Bio Paragraph -->
      <p class="mt-5 text-lg sm:text-xl text-slate-600 max-w-2xl mx-auto leading-relaxed">
        I'm a proud dog mom to a <strong class="text-slate-800">clever, nosy, clicker-trained pup</strong> and a very busy <strong class="text-slate-800">4.5-pound kitten</strong>—a tiny fuzzy ball of adorable chaos who loves stealing water out of glasses and food off plates!
      </p>

      <!-- Interactive Cheer-Up Actions Row -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <!-- Instant Cheer Confetti Button -->
        <button id="cheerBtn" class="bg-gradient-to-r from-rose-500 to-amber-500 hover:from-rose-600 hover:to-amber-600 text-white font-semibold px-6 py-3.5 rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-0.5 flex items-center gap-2 text-base active:scale-95" aria-label="Press to release cheerful confetti and sound">
          <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i>
          <span>Need a Instant Cheer Up?</span>
        </button>

        <!-- Clicker Simulator Button -->
        <button id="clickerBtn" class="bg-amber-50 hover:bg-amber-100 text-amber-800 font-semibold px-5 py-3.5 rounded-2xl border border-amber-200 shadow-sm transition-all duration-200 flex items-center gap-2 text-base active:scale-95 hover-wiggle" aria-label="Simulate a training clicker sound for dogs">
          <i class="fa-solid fa-bullhorn text-amber-600" aria-hidden="true"></i>
          <span>Clicker Sound 🐶</span>
        </button>
      </div>

      <!-- Audio Element for Clicker Simulator (Self-contained synthesized Web Audio API fallback in JS) -->
      <div id="toastMessage" class="hidden fixed bottom-6 right-6 bg-slate-800 text-white px-5 py-3 rounded-xl shadow-2xl z-50 transition-all duration-300 items-center gap-3 border border-slate-700" role="status" aria-live="polite">
